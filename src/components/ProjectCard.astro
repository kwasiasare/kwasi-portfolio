---
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, status, stack, epic } = project.data;
---

<article class="card project-card">
  <div class="project-card-head">
    <StatusBadge status={status} />
    <span class="chip epic-chip">{epic}</span>
  </div>
  <h3>
    <a class="project-card-link" href={`/projects/${project.id}/`}>{title}</a>
  </h3>
  <p class="project-summary">{summary}</p>
  <ul class="project-stack" role="list" aria-label="Stack">
    {stack.slice(0, 4).map((tech) => (
      <li class="chip">{tech}</li>
    ))}
    {stack.length > 4 && <li class="chip">+{stack.length - 4} more</li>}
  </ul>
  <span class="project-cta" aria-hidden="true">View project details →</span>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card {
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .project-card:hover {
      transform: translateY(-3px);
    }
  }

  .project-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .epic-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  /* Stretched-link pattern: the visible/focusable link's accessible name is
     just the project title (not the badge, chips, or CTA text). The ::after
     overlay extends the clickable area to the whole card. */
  .project-card-link {
    color: inherit;
    text-decoration: none;
  }

  .project-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project-card-link:hover {
    text-decoration: underline;
  }

  .project-summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .project-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .project-cta {
    margin-top: 0.25rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-accent-strong);
  }
</style>
