---
interface Props {
  repoUrl?: string;
  repoName?: string;
  repoVisibility: "public" | "private" | "pending";
  confluenceUrl?: string;
  confluenceLabel: string;
  liveUrl?: string;
  docsSlug?: string;
}

const { repoUrl, repoName, repoVisibility, confluenceUrl, confluenceLabel, liveUrl, docsSlug } =
  Astro.props;
const showRepoLink = repoVisibility === "public" && !!repoUrl;
---

<div class="link-row">
  {liveUrl && (
    <a class="btn btn-primary" href={liveUrl} target="_blank" rel="noopener noreferrer">
      Visit live site
    </a>
  )}
  {showRepoLink ? (
    <a
      class:list={["btn", liveUrl ? "btn-secondary" : "btn-primary"]}
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      View {repoName ?? "source"} on GitHub
    </a>
  ) : repoVisibility === "private" ? (
    <span class="repo-private chip">Private repository — available on request</span>
  ) : repoVisibility === "pending" ? (
    <span class="repo-private chip">Private repository — public release pending security scan</span>
  ) : repoName ? (
    <span class="repo-pending">
      <code>{repoName}</code> — repository will be linked here once this project ships publicly.
    </span>
  ) : null}
  {docsSlug && (
    <a class="btn btn-secondary" href={`/docs/${docsSlug}/`}>
      Project docs
    </a>
  )}
  {!docsSlug && confluenceUrl && (
    <a class="btn btn-secondary" href={confluenceUrl} target="_blank" rel="noopener noreferrer">
      {confluenceLabel}
    </a>
  )}
</div>

<style>
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  .repo-private {
    font-size: 0.85rem;
  }

  .repo-pending {
    color: var(--color-text-muted);
  }

  .repo-pending code {
    background: var(--color-bg-inset);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
