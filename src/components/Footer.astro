---
const year = new Date().getFullYear();
const linkedInUrl = "https://www.linkedin.com/in/asare-kwasi";
---

<footer class="site-footer" id="contact">
  <div class="wrap site-footer-inner">
    <div>
      <p class="footer-name">Kwasi Asare</p>
      <p class="footer-title">Senior Systems Engineer</p>
    </div>
    <a class="btn btn-primary" href={linkedInUrl} target="_blank" rel="noopener noreferrer">
      Connect on LinkedIn
    </a>
  </div>
  <div class="wrap footer-meta">
    <p>&copy; {year} Kwasi Asare. Built with Astro, hosted on Azure Static Web Apps.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-block: 2.5rem 1.5rem;
  }

  .site-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-name {
    margin: 0;
    font-weight: 700;
  }

  .footer-title {
    margin: 0.15rem 0 0;
    color: var(--color-text-muted);
  }

  .footer-meta {
    margin-top: 1.75rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .footer-meta p {
    margin: 0;
  }
</style>
