---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getPublishedProjects } from "../../lib/projects";

const projects = await getPublishedProjects();
const docs = await getCollection("docs");

// Groups follow the projects' own order; the main doc (no parent) comes
// first, then children by `order`.
const groups = projects
  .map((p) => ({
    project: p,
    docs: docs
      .filter((d) => d.data.project.id === p.id)
      .sort((a, b) => Number(!!a.data.parent) - Number(!!b.data.parent) || a.data.order - b.data.order),
  }))
  .filter((g) => g.docs.length > 0);
---

<BaseLayout
  title="Documents"
  description="Technical documentation for the products in the portfolio: architecture, deployment, operations and lessons learned."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1>Documents</h1>
      <p class="intro">
        Technical documentation for the products in the portfolio: architecture,
        deployment, operations and lessons learned. Mirrored from the project
        spaces, with sensitive configuration removed.
      </p>
      {groups.map((g) => (
        <section class="group" aria-labelledby={`group-${g.project.id}`}>
          <h2 id={`group-${g.project.id}`}>{g.project.data.title}</h2>
          <div class="doc-grid">
            {g.docs.map((d) => (
              <article class="card doc-card">
                <h3>
                  <a class="doc-card-link" href={`/docs/${d.id}/`}>{d.data.title}</a>
                </h3>
                <p class="doc-summary">{d.data.summary}</p>
                <p class="doc-updated">Updated {d.data.updated}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .intro {
    max-width: 46rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin: 0 0 2.5rem;
  }

  .group + .group {
    margin-top: 3rem;
  }

  .group h2 {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1.25rem;
  }

  .doc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.5rem;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .doc-card {
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .doc-card:hover {
      transform: translateY(-3px);
    }
  }

  .doc-card h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  /* Stretched-link pattern, as in ProjectCard. */
  .doc-card-link {
    color: inherit;
    text-decoration: none;
  }

  .doc-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .doc-card-link:hover {
    text-decoration: underline;
  }

  .doc-summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.93rem;
    flex-grow: 1;
  }

  .doc-updated {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
</style>
