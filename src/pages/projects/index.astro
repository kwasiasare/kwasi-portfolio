---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Six sequenced engineering projects, from identity automation to a containerized security dashboard.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Program</p>
      <h1>Projects</h1>
      <p class="intro">
        Six projects, built and shipped in sequence, each an independent
        public repository with its own CI. Status badges are honest: nothing
        here is marked shipped until it has a green pipeline and a live repo.
      </p>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .intro {
    max-width: 46rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin: 0 0 2.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
</style>
