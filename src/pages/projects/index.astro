---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getPublishedProjects, groupByCategory } from "../../lib/projects";

const projects = await getPublishedProjects();
const groups = groupByCategory(projects);
---

<BaseLayout title="Projects" description="Products and client systems built under Spreadcom LLC, plus the six-project Engineering Portfolio program — each with an honest status badge and links to source and docs.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1>Projects</h1>
      <p class="intro">
        Products and client systems I have built and operate, followed by the
        six-project Engineering Portfolio program. Status badges are honest:
        a product is shipped only when it is live for real users; a program
        project only when its repo is public with green CI.
      </p>
      {projects.length === 0 ? (
        <p class="empty-state">No projects published yet — check back soon.</p>
      ) : (
        groups.map((g) => (
          <section class="group" aria-labelledby={`group-${g.key}`}>
            <h2 id={`group-${g.key}`}>{g.label}</h2>
            <p class="group-blurb">{g.blurb}</p>
            <div class="project-grid">
              {g.projects.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          </section>
        ))
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .intro {
    max-width: 46rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin: 0 0 2.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .group + .group {
    margin-top: 3rem;
  }

  .group h2 {
    margin: 0 0 0.35rem;
    font-size: 1.5rem;
  }

  .group-blurb {
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
    max-width: 46rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: 2rem 0;
  }
</style>
